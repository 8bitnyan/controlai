-- controlai TimescaleDB init script for tenant {{.Tenant.ID}}
-- Generated by controlai — do not edit manually.
-- retention: {{.Tenant.Retention}}  chunk_time_interval: {{.Tenant.ChunkTimeInterval}}

CREATE EXTENSION IF NOT EXISTS timescaledb;

-- Ingest role with minimum privileges (INSERT on telemetry only).
DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='{{.Creds.IngestName}}') THEN
    CREATE ROLE {{.Creds.IngestName}} LOGIN PASSWORD '{{.Creds.IngestPass}}';
  END IF;
END$$;

-- Telemetry hypertable
CREATE TABLE IF NOT EXISTS telemetry (
    time       TIMESTAMPTZ   NOT NULL,
    site_id    TEXT          NOT NULL,
    device_id  TEXT          NOT NULL,
    metric     TEXT          NOT NULL,
    payload    JSONB,
    raw        BYTEA
);

SELECT create_hypertable(
    'telemetry',
    'time',
    chunk_time_interval => INTERVAL '{{.Tenant.ChunkTimeInterval}}',
    if_not_exists => TRUE
);

CREATE INDEX IF NOT EXISTS idx_telemetry_site_time
    ON telemetry (site_id, time DESC);

-- Grant ingest role INSERT-only on telemetry.
GRANT USAGE ON SCHEMA public TO {{.Creds.IngestName}};
GRANT INSERT ON TABLE telemetry TO {{.Creds.IngestName}};

-- Retention policy
SELECT add_retention_policy(
    'telemetry',
    INTERVAL '{{.Tenant.Retention}}',
    if_not_exists => TRUE
);

{{- if .Tenant.CompressionOn}}
-- Compression policy (retention >= 7d)
ALTER TABLE telemetry SET (
    timescaledb.compress,
    timescaledb.compress_segmentby = 'site_id,device_id'
);

SELECT add_compression_policy(
    'telemetry',
    INTERVAL '7 days',
    if_not_exists => TRUE
);
{{- end}}
