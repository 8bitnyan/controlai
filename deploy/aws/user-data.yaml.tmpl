Content-Type: text/cloud-config; charset="us-ascii"

#cloud-config
package_update: true
package_upgrade: true
packages:
  - ca-certificates
  - curl
  - gnupg
  - jq
  - openssl
  - unzip
# Note: the install.sh shipped in the release tarball creates the controlai
# system user and writes /etc/controlai/env with the right ownership. We do
# not write_files here because cloud-init's write_files runs before the
# bash section, and the 'controlai' group does not exist yet → recoverable
# error that taints `cloud-init status` even though the daemon ends up healthy.

--//
Content-Type: text/x-shellscript; charset="us-ascii"

#!/usr/bin/env bash
set -euo pipefail

log() {
  logger -t controlai-bootstrap "$1"
  printf '[controlai-bootstrap] %s\n' "$1"
}

log "installing docker prerequisites"
install -d -m 0755 /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc

cat >/etc/apt/sources.list.d/docker.sources <<'EOF_DOCKER_SOURCE'
Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: noble
Components: stable
Architectures: amd64
Signed-By: /etc/apt/keyrings/docker.asc
EOF_DOCKER_SOURCE

apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
systemctl enable --now docker

# Ubuntu 24.04 (Noble) removed the legacy `awscli` apt package (it was Python v1
# and EOL). Install AWS CLI v2 from the official zip — required by the SSM key
# fetch step below.
log "installing AWS CLI v2"
curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
unzip -qo /tmp/awscliv2.zip -d /tmp/
/tmp/aws/install --update

VERSION="${CONTROLAI_VERSION}"
if [ "${CONTROLAI_VERSION}" = "latest" ]; then
  VERSION="$(curl -fsSL "https://api.github.com/repos/${GITHUB_RELEASES_REPO}/releases/latest" | jq -r .tag_name)"
fi

log "downloading controlai ${VERSION}"
curl -fsSL -o /tmp/controlai.tgz "https://github.com/${GITHUB_RELEASES_REPO}/releases/download/${VERSION}/controlai_${VERSION#v}_linux_amd64.tar.gz"
tar -xzf /tmp/controlai.tgz -C /tmp/

log "running packaged installer (installs binary + systemd units + creates user)"
# install.sh moves /tmp/controlai → /usr/local/bin/controlai. Do NOT pre-install
# here: install.sh's `install` command would error if src and dst are identical.
CONTROLAI_BINARY=/tmp/controlai bash /tmp/install.sh

log "loading CA key from SSM"
KEY="$(aws ssm get-parameter --region ${AWS_REGION} --name ${SSM_PARAM_NAME} --with-decryption --query Parameter.Value --output text)"
cat >/etc/controlai/env <<EOF_CONTROLAI_ENV
CONTROLAI_CA_KEY_ENCRYPTION_KEY=${KEY}
EOF_CONTROLAI_ENV
chown root:controlai /etc/controlai/env
chmod 0640 /etc/controlai/env

log "starting controlai"
systemctl daemon-reload
systemctl enable --now controlai

# ── Traefik installation ─────────────────────────────────────────────────────
TRAEFIK_VERSION="3.3.5"
log "installing Traefik v${TRAEFIK_VERSION}"
curl -fsSL -o /tmp/traefik.tar.gz \
  "https://github.com/traefik/traefik/releases/download/v${TRAEFIK_VERSION}/traefik_v${TRAEFIK_VERSION}_linux_amd64.tar.gz"
tar -xzf /tmp/traefik.tar.gz -C /tmp/ traefik
install -m 0755 /tmp/traefik /usr/local/bin/traefik
rm -f /tmp/traefik.tar.gz /tmp/traefik

# Create Traefik directory structure.
# Traefik static config (/etc/traefik/traefik.yml) and dynamic config
# (/etc/traefik/dynamic/api.yml) are uploaded by up.sh after provisioning.
install -d -m 0755 /etc/traefik
install -d -m 0755 /etc/traefik/dynamic
install -d -m 0700 /etc/traefik/acme
# acme.json must exist and be 0600 before Traefik starts; it stores LE account + certs.
touch /etc/traefik/acme/acme.json
chmod 0600 /etc/traefik/acme/acme.json

# Traefik systemd unit — starts after network is up; config files are uploaded by up.sh.
cat >/etc/systemd/system/traefik.service <<'EOF_TRAEFIK_SVC'
[Unit]
Description=Traefik reverse proxy
Documentation=https://doc.traefik.io/traefik/
After=network-online.target
Wants=network-online.target
ConditionFileIsExecutable=/usr/local/bin/traefik

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/traefik --configFile=/etc/traefik/traefik.yml
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576
# Allow binding to privileged ports (:80, :443).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
EOF_TRAEFIK_SVC

# ── Daemon TCP listener — self-signed localhost cert ─────────────────────────
# The controlai daemon TCP listener requires TLS (--tls-cert / --tls-key).
# Generate a self-signed cert for 127.0.0.1/localhost that Traefik will connect
# to with insecureSkipVerify=true (localhost-only; no CA trust needed).
# Daemon TCP listen port — must match DAEMON_TCP_PORT in up.sh and Traefik config.
# This is substituted by envsubst in up.sh at provision time.
DAEMON_TCP_PORT="${DAEMON_TCP_PORT}"
log "generating self-signed cert for daemon TCP listener on :${DAEMON_TCP_PORT}"
openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 \
  -days 3650 -nodes \
  -subj "/CN=localhost" \
  -addext "subjectAltName=IP:127.0.0.1,DNS:localhost" \
  -keyout /etc/controlai/daemon-tcp.key \
  -out /etc/controlai/daemon-tcp.crt 2>/dev/null
chown root:controlai /etc/controlai/daemon-tcp.key /etc/controlai/daemon-tcp.crt
chmod 0640 /etc/controlai/daemon-tcp.key /etc/controlai/daemon-tcp.crt

# Systemd drop-in: add --tcp-addr and TLS flags to the daemon service.
DAEMON_DROP_IN_DIR="/etc/systemd/system/controlai.service.d"
install -d -m 0755 "${DAEMON_DROP_IN_DIR}"
cat >"${DAEMON_DROP_IN_DIR}/tcp-listener.conf" <<EOF_DAEMON_DROPIN
[Service]
# Append TCP listener flags to the daemon start command.
# Generated by deploy/aws/user-data.yaml.tmpl at provision time.
ExecStart=
ExecStart=/usr/local/bin/controlai daemon start \
  --tcp-addr :${DAEMON_TCP_PORT} \
  --tls-cert /etc/controlai/daemon-tcp.crt \
  --tls-key /etc/controlai/daemon-tcp.key
EOF_DAEMON_DROPIN

# Restart daemon to pick up the new ExecStart with TCP listener.
log "restarting controlai with TCP listener on :${DAEMON_TCP_PORT}"
systemctl daemon-reload
systemctl restart controlai

echo "[controlai-bootstrap] complete"

--//--
