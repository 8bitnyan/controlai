# Example environment variables for deploy/aws/up.sh.
# Copy this file to env.sh, fill in values, then `source env.sh` before running up.sh.
# DO NOT commit env.sh — it is in .gitignore.

# ── Required ──────────────────────────────────────────────────────────────────

export AWS_REGION="us-east-1"

# Email address used for Let's Encrypt ACME account registration.
# You will receive expiry warnings at this address.
export ACME_EMAIL="you@example.com"

# ── Optional ──────────────────────────────────────────────────────────────────

# Deployment name (used as subdomain prefix: <DEPLOYMENT_NAME>.sslip.io).
export DEPLOYMENT_NAME="controlai-poc"

# EC2 instance type.
export INSTANCE_TYPE="t3.medium"

# controlai release to install (default: latest).
export CONTROLAI_VERSION="latest"

# GitHub repo that publishes controlai releases.
export GITHUB_RELEASES_REPO="8bitnyan/controlai"

# Daemon TCP listen port (Traefik proxies to this port on localhost).
# Must match the TCP_LISTEN_ADDR configured for the controlai daemon.
export DAEMON_TCP_PORT="8080"

# ACME staging flag.
#   1 (default) → Let's Encrypt staging CA (untrusted cert; safe for development).
#   0           → Let's Encrypt production CA (browser-trusted; subject to rate limits).
# Use staging until you have validated cert acquisition, then run:
#   ./deploy/aws/scripts/flip-acme-prod.sh
export ACME_STAGING="1"

# Custom domain override (replaces <public_ip>.sslip.io with a real domain).
# Leave empty to use the auto-generated sslip.io address.
export DEPLOYMENT_DOMAIN=""

# Elastic IP (true/false). Set true for a stable IP across instance replacements.
export ENABLE_EIP="false"

# Name of an existing EC2 key pair to use (leave empty to auto-create).
export SSH_KEY_NAME=""
