# Instantiated service unit for per-tenant controlai backups.
# Paired with a per-tenant .timer unit generated by `controlai tenant create`.
# Instance name (%i) is the tenant ID, e.g. controlai-backup@tnt_acme-corp.service.
[Unit]
Description=controlai backup for tenant %i
After=controlai.service
Requires=controlai.service

[Service]
Type=oneshot
User=controlai
ExecStart=/usr/local/bin/controlai backup run %i
StandardOutput=journal
StandardError=journal
